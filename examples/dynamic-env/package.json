{
  "name": "dynamic-env-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env APP_ENV=local node server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "npm run build && cross-env NODE_ENV=production APP_ENV=prod node server"
  },
  "dependencies": {
    "@layerfig/config": "3.1.0",
    "compression": "1.8.1",
    "express": "5.2.1",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "cross-env": "10.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
