---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "starlight-theme-nova/components";
import fs from "node:fs";
import path from "node:path";
import { examples } from "./examples";

export function getStaticPaths() {
  return Array.from(examples.values())
    .filter((e) => e.isExternal === false)
    .map((example) => example.route);
}

const { name } = Astro.params;

if (!name) {
  throw new Error("Missing name parameter");
}

const example = examples.get(name);

if (!example) {
  throw new Error(`Example "${name}" not found`);
}

const LANG_BY_EXTENSION: Record<string, string> = {
  ".ts": "ts",
  ".tsx": "tsx",
  ".js": "js",
  ".json": "json",
  ".jsonc": "jsonc",
  ".json5": "json5",
  ".yaml": "yaml",
  ".yml": "yaml",
  ".toml": "toml",
};

/**
 * The embed below is the whole example, but an iframe is invisible to search
 * engines and useless on a narrow screen — so the entry file is also rendered
 * inline. Reading it from the repo means it can never drift from the example
 * that actually runs.
 */
const repoRoot = path.resolve(process.cwd(), "..");
const sourcePath = path.join(repoRoot, example.startFilePath);

let source: string | null = null;
try {
  source = fs.readFileSync(sourcePath, "utf8").trimEnd();
} catch {
  throw new Error(
    `Example "${name}" points at "${example.startFilePath}", which does not exist. ` +
      `Update startFile in src/pages/examples/examples.ts.`,
  );
}

const language =
  LANG_BY_EXTENSION[path.extname(example.startFile)] ?? "plaintext";
---

<StarlightPage
  frontmatter={{
    title: example.title,
    tableOfContents: false,
  }}
>
  {example.note && <p>{example.note}</p>}

  <details class="source" open>
    <summary>
      <code>{example.startFile}</code>
      <a href={example.repoURL} target="_blank" rel="noreferrer">
        View the full example on GitHub →
      </a>
    </summary>
    <Code code={source} lang={language} />
  </details>

  <iframe
    src={example.src}
    title={`${example.title} — live example`}
    allow="cross-origin-isolated"></iframe>
</StarlightPage>

<style lang="postcss">
  :root {
    --sl-content-margin-inline: none;
    --sl-content-width: 100% !important;
  }

  /**
   * The page used to be nothing but the embed, so the whole frame was pinned to
   * the viewport height to make the iframe fill it. Now that the entry file is
   * rendered above it, the page scrolls normally and the embed takes a fixed
   * share of the viewport instead.
   */
  :global(main[data-pagefind-body]) {
    .content-panel:nth-child(2) footer {
      display: none;
    }
  }

  iframe {
    width: 100%;
    border: none;
    border-radius: 0.8rem;
    height: clamp(30rem, 75svh, 60rem);
  }

  .source {
    margin-block-end: 1rem;
  }

  .source summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    cursor: pointer;
    padding-block-end: 0.5rem;
  }

  .source summary a {
    font-size: 0.875rem;
  }
</style>

<script>
  changeTheme();

  const themeSelector = document.querySelector("starlight-theme-select select");
  if (themeSelector) {
    themeSelector.addEventListener("change", (e) => {
      changeTheme();
    });
  }

  function changeTheme() {
    const iframe = document.querySelector("iframe")!;
    const { theme } = document.documentElement.dataset;

    const url = new URL(iframe.src);

    if (theme) {
      url.searchParams.set("theme", theme);
      iframe.src = url.toString();
    }
  }
</script>
