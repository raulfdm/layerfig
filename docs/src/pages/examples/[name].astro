---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { examples } from "./examples";

export function getStaticPaths() {
  return Array.from(examples.values())
    .filter((e) => e.isExternal === false)
    .map((example) => example.route);
}

const { name } = Astro.params;

if (!name) {
  throw new Error("Missing name parameter");
}

const example = examples.get(name);

if (!example) {
  throw new Error(`Example "${name}" not found`);
}
---

<StarlightPage
  frontmatter={{
    title: example.title,
    tableOfContents: false,
  }}
>
  {
    example.note && (
      <p class="note">
        {/* Notes carry file names and API identifiers, so backtick spans in
            the note text are rendered as inline code. */}
        {example.note
          .split(/`([^`]+)`/)
          .map((part, i) => (i % 2 ? <code>{part}</code> : part))}
      </p>
    )
  }

  <iframe
    src={example.src}
    title={`${example.title} — live example`}
    allow="cross-origin-isolated"></iframe>
</StarlightPage>

<style lang="postcss">
  :root {
    --sl-content-margin-inline: none;
    --sl-content-width: 100% !important;
  }

  :global(.main-frame, .main-frame > div) {
    height: calc(100svh - var(--sl-nav-height)) !important;
  }

  :global(.main-pane){
    height: 100%;
  }

  :global(main[data-pagefind-body]) {
    height: 100%;
    display: flex;
    flex-direction: column;

    .content-panel:nth-child(2) {
      flex: 1;

      .sl-container,
      .sl-markdown-content {
        height: 100%;
      }

      /**
       * The note sits above the embed, so the content becomes a column and
       * the iframe takes whatever height is left over instead of a flat
       * 100% that would push the page into overflow.
       */
      .sl-markdown-content {
        display: flex;
        flex-direction: column;
      }

      footer {
        display: none;
      }
    }
  }

  .note {
    max-width: 75ch;
  }

  iframe {
    width: 100%;
    border: none;
    border-radius: 0.8rem;
    flex: 1;
    /* Keeps the embed usable when a long note eats the viewport on mobile. */
    min-height: 25rem;
  }
</style>

<script>
  changeTheme();

  const themeSelector = document.querySelector("starlight-theme-select select");
  if (themeSelector) {
    themeSelector.addEventListener("change", (e) => {
      changeTheme();
    });
  }

  function changeTheme() {
    const iframe = document.querySelector("iframe")!;
    const { theme } = document.documentElement.dataset;

    const url = new URL(iframe.src);

    if (theme) {
      url.searchParams.set("theme", theme);
      iframe.src = url.toString();
    }
  }
</script>
